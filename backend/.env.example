# Copy this file to ".env" and fill in your own values.
# Never commit the real .env file.

# Server
PORT=5000
CLIENT_URL=http://localhost:5173

# MongoDB Atlas
# Format: mongodb+srv://<username>:<password>@<cluster-address>/<database-name>?retryWrites=true&w=majority
# Replace <username>, <password> and <cluster-address> with your own values.
# Keep "/wageguard" as the database name. Do NOT put real credentials in this file.
MONGODB_URI=mongodb+srv://your-username:your-password@your-cluster.mongodb.net/wageguard?retryWrites=true&w=majority

# Gemini API (AI conversation analysis and scope checks)
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key-here
# Model name. Google retires models over time, so if you get "model not available",
# pick a current Flash model in Google AI Studio and put its name here.
GEMINI_MODEL=gemini-3.8-flash
# Optional: how long to wait for Gemini, in milliseconds (default 45000)
# GEMINI_TIMEOUT_MS=45000

# PayPal Sandbox (used in a later stage)
PAYPAL_CLIENT_ID=your-paypal-sandbox-client-id-here
PAYPAL_CLIENT_SECRET=your-paypal-sandbox-client-secret-here
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
